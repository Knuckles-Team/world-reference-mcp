# world-reference-mcp — copy to .env and fill in as needed.
# Every value below is a documented default; only the two credential
# references are required for their two tools (fdc_food_search, noaa_ghcnd_daily).

# Transport / MCP server (see agent_connector_sdk.mcp.parser for the full flag set)
TRANSPORT=stdio
MCP_TOOL_MODE=condensed

# Contact identity advertised to NCBI/GBIF/Wikidata (their usage policies ask for one)
WORLD_REFERENCE_CONTACT_EMAIL=connectors@knuckles.team

# Credentials — env:// (default) or openbao://apps/world-reference-mcp#<FIELD>
WORLD_REFERENCE_FDC_API_KEY=env://WORLD_REFERENCE_FDC_API_KEY
WORLD_REFERENCE_NOAA_TOKEN=env://WORLD_REFERENCE_NOAA_TOKEN

# Per-source overrides (base URLs, request pacing, page sizes) — see config.py;
# uncomment only to point at a mirror or tune throughput.
# WORLD_REFERENCE_NCBI_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
# WORLD_REFERENCE_NCBI_MIN_INTERVAL=0.35
# WORLD_REFERENCE_GBIF_BASE_URL=https://api.gbif.org/v1
# WORLD_REFERENCE_GBIF_MIN_INTERVAL=0.2
# WORLD_REFERENCE_OLS4_BASE_URL=https://www.ebi.ac.uk/ols4/api
# WORLD_REFERENCE_OLS4_MIN_INTERVAL=0.2
# WORLD_REFERENCE_FDC_BASE_URL=https://api.nal.usda.gov/fdc/v1
# WORLD_REFERENCE_FDC_MIN_INTERVAL=1.0
# WORLD_REFERENCE_INATURALIST_BASE_URL=https://api.inaturalist.org/v1
# WORLD_REFERENCE_INATURALIST_MIN_INTERVAL=1.1
# WORLD_REFERENCE_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# WORLD_REFERENCE_OPEN_METEO_MIN_INTERVAL=1.0
# WORLD_REFERENCE_NOAA_BASE_URL=https://www.ncei.noaa.gov/cdo-web/api/v2
# WORLD_REFERENCE_NOAA_MIN_INTERVAL=0.25
# WORLD_REFERENCE_WIKIDATA_BASE_URL=https://query.wikidata.org
# WORLD_REFERENCE_WIKIDATA_MIN_INTERVAL=1.0
